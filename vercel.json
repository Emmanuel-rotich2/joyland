{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{index.php,auth/**/*.php,member/**/*.php,staff/**/*.php,api/**/*.php,includes/**/*.php,config/**/*.php,assets/**/*,manifest.webmanifest}"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php?__path=$1"
    }
  ]
}